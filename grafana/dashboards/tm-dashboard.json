          "rawSql": "WITH heater_data AS (SELECT pk.ts AS \"time\", p.name AS \"metric\", p.value_num AS \"value\", LAG(p.value_num) OVER (PARTITION BY p.name ORDER BY pk.ts) as prev_val FROM parameters p JOIN packets pk ON p.packet_id = pk.id WHERE pk.ts >= $__timeFrom()::timestamptz AND pk.ts <= $__timeTo()::timestamptz AND p.name IN ('prim_heater_ch1_status.pwm', 'prim_heater_ch2_status.pwm') ) SELECT \"time\", \"metric\", \"value\" FROM heater_data WHERE prev_val IS NULL OR \"value\" != prev_val ORDER BY \"time\" ASC;",
