 # Ingestion
 TM_LISTEN_HOST=0.0.0.0
 TM_LISTEN_PORT=9100          # TCP source
 TM_UDP_PORT=9200             # UDP source (matches backend UDP listener)

# Serial source (leave SERIAL_ENABLED=false to skip)
 SERIAL_ENABLED=false
 SERIAL_PORT=/tmp/ttyV1
 SERIAL_BAUD=115200

 ENABLE_SIM=false
 SIM_RATE_HZ=10
 
 # Storage
 REDIS_URL=redis://localhost:6379/0
 POSTGRES_URL=postgresql+asyncpg://tm:tm@localhost:5432/tmdb
 
 # API
 CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
 API_PORT=8000
 
 # Dev server: hot-reload. OFF unless you're editing backend code.
 RELOAD=false

 #Debugging
 DEBUG_PACKET_BUILD=false
 
 TM_DECODER=ebox   # "custom" | "pus" | "ebox"